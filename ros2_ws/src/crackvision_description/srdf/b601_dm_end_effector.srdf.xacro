<?xml version="1.0"?>
<!--
  b601_dm_end_effector.srdf.xacro — the vendor SRDF (rebotarm_moveit_config/config/rebotarm.srdf, read-only
  underlay: groups `arm` (chain base_link -> gripper_tcp) / `gripper`, states, vendor ACM) plus the
  self-collision pairs of the ADR-014 overlay links that can never move relative to each other, taken from
  config/robot/end_effector.yaml `allowed_self_collisions`. Environment collisions (table, specimen) and
  every arm link vs. the camera proxies stay enabled.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="reBot_B601_DM_with_gripper">
  <xacro:arg name="end_effector_config" default=""/>

  <xacro:include filename="$(find rebotarm_moveit_config)/config/rebotarm.srdf"/>

  <xacro:property name="ee" value="${xacro.load_yaml('$(arg end_effector_config)')}"/>

  <xacro:macro name="crackvision_disable_pairs" params="pairs">
    <xacro:if value="${len(pairs) > 0}">
      <disable_collisions link1="${pairs[0][0]}" link2="${pairs[0][1]}" reason="Never"/>
      <xacro:crackvision_disable_pairs pairs="${pairs[1:]}"/>
    </xacro:if>
  </xacro:macro>
  <xacro:crackvision_disable_pairs pairs="${ee.allowed_self_collisions}"/>
</robot>
